    },
    "enabled": {
      "type": "boolean"
    },
    "etag": {
      "type": "string"
    },
    "kill_switch": {
      "type": "boolean"
    },
    "limits": {
      "additionalProperties": false,
      "properties": {
        "default_token_budget": {
          "minimum": 0,
