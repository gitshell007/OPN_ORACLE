[Unit]
Description=OPN Oracle Celery beat (native dev, single instance)
After=network-online.target postgresql.service redis-server.service
Wants=network-online.target
Requires=postgresql.service redis-server.service

[Service]
Type=simple
User=opn-oracle
Group=opn-oracle
WorkingDirectory=/opt/opn-oracle/current/apps/api
EnvironmentFile=/etc/opn-oracle-dev/oracle.env
Environment=PYTHONPATH=/opt/opn-oracle/current/apps/api/src
Environment=PATH=/opt/opn-oracle/current/apps/api/.venv/bin:/usr/local/bin:/usr/bin
ExecStart=/opt/opn-oracle/current/apps/api/.venv/bin/celery \
  -A opn_oracle.celery_entry:celery beat \
  --loglevel=INFO \
  --schedule=/var/lib/opn-oracle-dev/celerybeat-schedule \
  --pidfile=/var/lib/opn-oracle-dev/celerybeat.pid
Restart=on-failure
RestartSec=5
TimeoutStopSec=45
KillMode=mixed
LimitNOFILE=65535
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/opn-oracle-dev /var/log/opn-oracle-dev /tmp
ReadOnlyPaths=/opt/opn-oracle /etc/opn-oracle-dev
UMask=0027
StandardOutput=journal
StandardError=journal
SyslogIdentifier=opn-oracle-beat

[Install]
WantedBy=multi-user.target
