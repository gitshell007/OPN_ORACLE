[Unit]
Description=OPN Oracle API (Gunicorn native dev)
After=network-online.target postgresql.service redis-server.service
Wants=network-online.target
Requires=postgresql.service redis-server.service

[Service]
Type=simple
User=opn-oracle
Group=opn-oracle
WorkingDirectory=/opt/opn-oracle/current/apps/api
EnvironmentFile=/etc/opn-oracle-dev/oracle.env
Environment=PYTHONPATH=/opt/opn-oracle/current/apps/api/src
Environment=PATH=/opt/opn-oracle/current/apps/api/.venv/bin:/usr/local/bin:/usr/bin
ExecStart=/opt/opn-oracle/current/apps/api/.venv/bin/gunicorn \
  -c /opt/opn-oracle/current/apps/api/gunicorn.conf.py \
  opn_oracle.wsgi:app
Restart=on-failure
RestartSec=5
TimeoutStopSec=45
KillMode=mixed
LimitNOFILE=65535
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/opn-oracle-dev /var/log/opn-oracle-dev /var/backups/opn-oracle-dev /tmp
ReadOnlyPaths=/opt/opn-oracle /etc/opn-oracle-dev
CapabilityBoundingSet=
AmbientCapabilities=
LockPersonality=true
MemoryDenyWriteExecute=false
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
UMask=0027
StandardOutput=journal
StandardError=journal
SyslogIdentifier=opn-oracle-api

[Install]
WantedBy=multi-user.target
