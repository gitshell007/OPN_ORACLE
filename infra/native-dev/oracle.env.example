# Configuración no secreta para Oracle dev nativo.
# Copiar a /etc/opn-oracle-dev/oracle.env (no versionar valores reales).
ORACLE_RELEASE=replace-with-immutable-release-id
ORACLE_APP_VERSION=0.1.0
APP_ENV=production
FLASK_DEBUG=false
RLS_ENABLED=true
LOG_LEVEL=INFO
LOG_FORMAT=json
TRUSTED_PROXY_COUNT=1
FRONTEND_ORIGIN=https://oracle-dev.opnconsultoria.com
OPENAPI_ENABLED=false
HSTS_ENABLED=false
METRICS_ENABLED=false
SQLALCHEMY_POOL_SIZE=3
SQLALCHEMY_MAX_OVERFLOW=2
SQLALCHEMY_POOL_TIMEOUT_SECONDS=2
DEPENDENCY_TIMEOUT_SECONDS=2
# APP_ENV=production exige smtp o graph completos; capture no es válido.
# SMTP a loopback no escuchado: fail-closed sin proveedores externos.
MAIL_BACKEND=smtp
SMTP_HOST=127.0.0.1
SMTP_PORT=2525
SMTP_USE_TLS=false
MAIL_FROM=oracle-dev@localhost
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_SENDER_MAILBOX=
GRAPH_TIMEOUT_SECONDS=10
CELERY_TASK_ALWAYS_EAGER=false
CELERY_TASK_EAGER_PROPAGATES=false
CELERY_ACKS_LATE=true
CELERY_WORKER_PREFETCH_MULTIPLIER=1
CELERY_TASK_SOFT_TIME_LIMIT=690
CELERY_TASK_TIME_LIMIT=720
CELERY_RESULT_EXPIRES=3600
CELERY_TIMEZONE=Europe/Madrid
CELERY_DEFAULT_QUEUE=default
NIGHTLY_SUMMARIES_ENABLED=false
SIGNAL_AVANZA_ENABLED=false
SIGNAL_AVANZA_MODE=mock
SIGNAL_AVANZA_CONTRACT_CONFIRMED=false
SIGNAL_AVANZA_ALLOWED_HOSTS=
SIGNAL_AVANZA_BASE_URL=
SIGNAL_AVANZA_API_VERSION=2026-07-01
AI_ENABLED=false
AI_MODE=disabled
AI_DEFAULT_MODEL=mock-oracle-v1
MEMORY_CONTEXT_MODE=disabled
MEMORY_CONTEXT_BASE_URL=
MEMORY_CONTEXT_TIMEOUT_SECONDS=10
SIGNAL_AI_BASE_URL=
SIGNAL_AI_ALLOWED_HOSTS=
SIGNAL_AI_TIMEOUT_SECONDS=300
ENTITY_INTEL_MAX_REGISTRY_ACTS=25
ENTITY_INTEL_MAX_AWARD_SOURCES=15
ENTITY_INTEL_MAX_EVIDENCE_SOURCES=45
# Dev-only document module: local disk + noop scanner.
# DOCUMENT_ALLOW_LOCAL_BACKEND / DOCUMENT_ALLOW_OFFICIAL_UNSCANNED are explicit
# exceptions so APP_ENV=production still requires S3+ClamAV when they are false.
DOCUMENTS_ENABLED=true
DOCUMENT_STORAGE_BACKEND=local
DOCUMENT_LOCAL_ROOT=/var/lib/opn-oracle-dev/document-storage
DOCUMENT_SCANNER_MODE=noop
DOCUMENT_ALLOW_LOCAL_BACKEND=true
DOCUMENT_ALLOW_OFFICIAL_UNSCANNED=true
DOCUMENT_MAX_BYTES=26214400

REPORT_PDF_MODE=weasyprint
BACKUP_STORAGE_PATH=/var/backups/opn-oracle-dev
BACKUP_RETENTION_DAYS=14
GUNICORN_BIND=127.0.0.1:8010
GUNICORN_WORKERS=2
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=65
ORACLE_SECRETS_DIR=/etc/opn-oracle-dev/secrets
# Secretos vía *_FILE (no inline):
SECRET_KEY_FILE=/etc/opn-oracle-dev/secrets/oracle_secret_key
DATABASE_URL_FILE=/etc/opn-oracle-dev/secrets/oracle_database_url
DATABASE_MIGRATION_URL_FILE=/etc/opn-oracle-dev/secrets/oracle_database_migration_url
REDIS_URL_FILE=/etc/opn-oracle-dev/secrets/oracle_redis_url
SESSION_REDIS_URL_FILE=/etc/opn-oracle-dev/secrets/oracle_session_redis_url
RATELIMIT_STORAGE_URL_FILE=/etc/opn-oracle-dev/secrets/oracle_ratelimit_redis_url
CELERY_BROKER_URL_FILE=/etc/opn-oracle-dev/secrets/oracle_celery_broker_url
CELERY_RESULT_BACKEND_FILE=/etc/opn-oracle-dev/secrets/oracle_celery_result_url
INTEGRATION_ENCRYPTION_KEYS_FILE=/etc/opn-oracle-dev/secrets/oracle_integration_encryption_keys
